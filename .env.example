# 复制为 .env 后填入真实密钥（.env 不会被提交）
# Docker 部署详见 docs/docker.md

# ----- Application -----
APP_HOST=0.0.0.0
APP_PORT=6006
APP_PUBLISH_PORT=6006
PREFER_CABIN_HMI=1
RESET_ON_STARTUP=0

# ----- MongoDB (Compose 服务名 mongodb) -----
MONGO_HOST=mongodb
MONGO_PORT=27017
MONGO_DB_NAME=mydatabase
MONGO_PUBLISH_PORT=27017
# MONGO_USERNAME=
# MONGO_PASSWORD=
# MONGO_AUTH_SOURCE=admin

# ----- Local vLLM (usually on host or another GPU machine) -----
VLLM_API_BASE=http://host.docker.internal:8000/v1
VLLM_API_KEY=EMPTY
VLLM_MODEL_NAME=qwen-4b-tesla
LLM_TIMEOUT_SEC=45
LLM_TEMPERATURE=0.2

# ----- Bailian (cloud LLM / speech) -----
BAILIAN_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
BAILIAN_API_KEY=
BAILIAN_MODEL_NAME=qwen3.5-flash

MOONSHOT_API_BASE=https://api.moonshot.cn/v1
MOONSHOT_API_KEY=
MOONSHOT_MODEL_NAME=moonshot-v1-32k

DOUBAO_API_KEY=
DOUBAO_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
DOUBAO_MODEL_NAME=

# ----- Speech (Bailian ASR + CosyVoice TTS) -----
ASR_MODEL=qwen3-asr-flash
TTS_MODEL=cosyvoice-v3-flash
TTS_VOICE=longanhuan
TTS_RATE=1.12

# ----- Amap -----
AMAP_MAPS_API_KEY=
AMAP_JS_KEY=
# AMAP_JS_SECURITY_CODE=

# ----- Web search -----
WEB_SEARCH_PROVIDER=auto
WEB_SEARCH_DASHSCOPE_MODEL=qwen-flash
TAVILY_API_KEY=
BOCHA_API_KEY=
BRAVE_SEARCH_API_KEY=

# ----- RAG -----
RAG_ENABLE=1
RAG_WARMUP_ON_STARTUP=1
RAG_BM25_TOPK=8
RAG_MILVUS_TOPK=8
RAG_RERANK_TOPK=4
RAG_SCORE_THRESHOLD=0.15

# ----- Agent / session -----
MAX_TOOL_CALLS=3
SESSION_TTL_SEC=21600
ADMIN_NICKNAME=象牙海岸
LLM_LOG_ENABLE=1

# ----- Docker volume paths (host; optional overrides) -----
# MODELS_DIR=./models
# SAVED_INDEX_DIR=./data/saved_index
# SAVED_IMAGES_DIR=./data/saved_images
# RERANKER_CHECKPOINT_DIR=./RAG-Retrieval/rag_retrieval/train/reranker/output/bert/runs/checkpoints/checkpoint_0
# TESLA_IMAGE=tesla-system:latest
# DOCKER_WAIT_TIMEOUT_SEC=120
