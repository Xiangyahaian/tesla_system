# 复制为 .env 后填入真实密钥（.env 不会被提交）

VLLM_API_BASE=http://127.0.0.1:8000/v1
VLLM_API_KEY=EMPTY
VLLM_MODEL_NAME=qwen-4b-tesla

MOONSHOT_API_BASE=https://api.moonshot.cn/v1
MOONSHOT_API_KEY=
MOONSHOT_MODEL_NAME=moonshot-v1-32k

BAILIAN_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
BAILIAN_API_KEY=
BAILIAN_MODEL_NAME=qwen3.5-flash

DOUBAO_API_KEY=
DOUBAO_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
DOUBAO_MODEL_NAME=

# 网页搜索。auto：优先用已有百炼 Key 走官方联网搜索（推荐），失败再 Bing HTML
WEB_SEARCH_PROVIDER=auto
WEB_SEARCH_DASHSCOPE_MODEL=qwen-flash
# 可选：专用搜索 API（比百炼更省、更稳）
TAVILY_API_KEY=
BOCHA_API_KEY=
BRAVE_SEARCH_API_KEY=
