  "categories": [
    {
      "id": "01_global_gates",
      "name": "全局门禁（是否允许走代码快路径）",
      "file": "app/nlu/destination_guard.py",
      "status": "active",
      "rules": [
        {
          "id": "gate_complex_length",
          "name": "复杂句长度门禁",
          "function": "is_complex_utterance / should_skip_code_fast_path",
          "status": "active",
          "condition": "len(query.strip()) > COMPLEX_UTTERANCE_MIN_CHARS",
          "constant": { "COMPLEX_UTTERANCE_MIN_CHARS": 10 },
          "effect": "try_fast_path_route 返回 None，交 StructuredNLU",
          "examples_skip": [
            "帮我导航到中关村软件园",
            "导航到中关村软件园，副驾空调22度，播放周杰伦的晴天"
          ],
          "examples_allow": ["打开空调", "我在哪", "自动泊车怎么用"]
        },
        {
          "id": "gate_compound_multi_tool",
          "name": "多域复合句门禁",
          "function": "is_compound_multi_tool_utterance",
          "status": "active",
          "condition": "detect_utterance_domains 含 navigation 且另有其它域（climate/media/maps/cabin/apps）",
          "domain_patterns": [
            { "domain": "navigation", "pattern": "导航|带我去|我想去|开导航|目的地" },
            { "domain": "climate", "pattern": "空调|温度|制冷|制热|风量|内循环|外循环|\\d{2}\\s*度" },
            { "domain": "media", "pattern": "播放|放首|放一首|来首|听一下|听首|音乐|电台|音量|下一首|上一首" },
            { "domain": "maps", "pattern": "附近|周边|旁边|充电站|加油站|停车场|美食|餐厅" },
            { "domain": "cabin", "pattern": "车窗|天窗|后备箱|前备箱|氛围灯|阅读灯" },
            { "domain": "apps", "pattern": "打开.{0,6}(飞书|微信|地图|高德|美团|应用)" }
          ],
          "effect": "跳过代码快路径（导航澄清选点除外）",
          "examples_skip": ["导航到中关村软件园，副驾空调22度，播放周杰伦的晴天"]
        },
        {
          "id": "gate_compound_dest_strip",
          "name": "导航目的地复合尾巴截断",
          "function": "strip_compound_tail_from_destination",
          "status": "post_llm",
          "file": "app/nlu/destination_guard.py + app/nlu/planner.py sanitize + app/gateway/stub.py navigate_to",
          "tail_patterns": [
            "[，,；;]\\s*(副驾|主驾|驾驶位|后排|左后|右后|中后).*$",
            "[，,；;]\\s*(空调|温度|制冷|制热|风量).*$",
            "[，,；;]\\s*(\\d{2})\\s*度.*$",
            "[，,；;]\\s*(播放|放首|放一首|来首|听一下|听首|播).*$",
            "[，,；;]\\s*(顺便|并且|同时|还要|再).*$"
          ],
          "example": {
            "before": "中关村软件园，副驾空调22度，播放周杰伦的晴天",
            "after": "中关村软件园"
          }
        },
        {
          "id": "gate_relative_destination",
          "name": "相对/类别目的地禁止 navigate_to",
          "function": "is_relative_or_category_destination",
          "status": "post_llm",
          "relative_pattern": "最近|附近|周边|旁边|四周|就近|顺路|找个|找一家|随便|任意|有什么|有哪些|哪儿有|哪里有",
          "category_only_words": [
            "商场", "购物中心", "超市", "便利店", "美食", "餐厅", "饭店", "咖啡", "咖啡馆", "咖啡厅",
            "充电站", "超充", "加油站", "停车场", "厕所", "卫生间", "药店", "医院", "景点", "公园"
          ],
          "examples_block": ["最近的商场", "附近充电站", "商场"]
        }
      ]
    },
