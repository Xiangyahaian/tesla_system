    {
      "id": "04_nav_clarification",
      "name": "导航澄清选点（有 nav_candidates 时）",
      "file": "app/nlu/nav_resolve.py",
      "status": "active",
      "entry": "try_nav_candidate_utterance → resolve_nav_selection",
      "rule_first_llm_fallback": "规则未命中时 _llm_resolve_nav_selection（LLM 在候选内选）",
      "rules": [
        {
          "id": "nav_cancel",
          "function": "_is_cancel",
          "patterns": [
            "^(取消|算了|不用了|不导航|别导了|先别|不要了)(导航|吧|啊|呀)?$",
            "取消导航|不走了|不去了"
          ],
          "action": "clear"
        },
        {
          "id": "nav_off_topic",
          "function": "_is_off_topic_from_nav",
          "exempt_if": "(第\\s*[一二三四五六七八九\\d]+\\s*(个|项|处|号|家)|那家|这家|上面|下面)",
          "patterns": "空调|温度|制热|制冷|座椅|车窗|天窗|氛围灯|阅读灯|放首歌|下一首|暂停|继续播放|音量|打开微信|打开地图|锁车|解锁|后备箱|哨兵|玩具箱|用户手册|怎么用|如何|为什么|讲个笑话|你好|谢谢|几点了|网上\\s*搜|搜一下|百度|谷歌|google|网页搜|搜索一下|好玩|有什么好玩|推荐一下|介绍一下",
          "action": "clear",
          "reason": "用户换题，释放导航候选"
        },
        {
          "id": "nav_explicit_new_dest",
          "function": "_is_explicit_new_destination",
          "action": "new_destination",
          "note": "否定候选+新意向 / 换地方 / 导航到与候选几乎无重合的新地名"
        },
        {
          "id": "nav_reject_candidates",
          "function": "_is_reject_current_candidates",
          "patterns": "都(不想要|不要|不是|不对|别去|不要了)|这些?(都)?(不要|不行|不对|别)|换(一批|别的|其他|其它)|^(不行|不对|不是|都不是|都不要)",
          "action": "clear"
        },
        {
          "id": "nav_index_pick",
          "function": "_index_pick",
          "patterns": [
            "纯数字 1-4",
            "(?:选\\s*)?(?:第\\s*)([1-4一二两三四])\\s*(?:个|项|处|号|家)?",
            "(?:选\\s*)([1-4])\\s*(?:个|项|处|号|家)"
          ],
          "forbidden": "禁止把「一下/一样」里的「一」当成第 1 个",
          "action": "navigate"
        },
        {
          "id": "nav_full_name_pick",
          "function": "_resolve_nav_selection_rules",
          "condition": "候选全称 len>=4 且 (name==core 或 name in text)",
          "action": "navigate",
          "reason": "点名全称"
        },
        {
          "id": "nav_constraint_filter",
          "function": "_filter_by_constraints / _constraint_tokens",
          "note": "A口/B口/南口/数字口/汉字约束，用于 LLM 前后辅助",
          "status": "auxiliary"
        }
      ],
      "tool_on_navigate": {
        "name": "navigation.navigate_to",
        "arguments": ["destination", "preference=fastest", "destination_location?"]
      }
    },
