    {"id": "V3-087", "cat": "hybrid", "q": "手册里座椅按摩怎么开，顺手把副驾按摩打开", "expect": {"min_tools": 1, "observe": true}},
    {"id": "V3-088", "cat": "hybrid", "q": "导航去大兴生物医药基地，路上用两句吐槽晚高峰", "expect": {"min_tools": 1, "observe": true}},
    {"id": "V3-089", "cat": "hybrid", "q": "搜网丽泽攀岩馆周末门票，音量调到22", "expect": {"tools_any": ["web.search"], "min_tools": 1}},
