    {"id": "V3-094", "cat": "post_compact", "q": "压缩后按偏好放一首李志", "expect": {"min_tools": 1, "observe": true}},
    {"id": "V3-095", "cat": "post_compact", "q": "压缩后重新导航望京SOHO，全车19度", "expect": {"min_tools": 2, "observe": true}},
    {"id": "V3-096", "cat": "post_compact", "q": "压缩后查副驾温度和WiFi", "expect": {"intent_in": ["search", "chat"], "observe": true}},

    {"id": "V3-097", "cat": "stress_combo", "q": "参谋口吻，顾行舟，主驾，万青，方向盘加热一档，eco空调", "expect": {"observe": true}},
    {"id": "V3-098", "cat": "stress_combo", "q": "附近超充找得到就导航，找不到就上网查最近的再报", "expect": {"observe": true}},
    {"id": "V3-099", "cat": "verify", "q": "汇总：我是谁、坐哪、音乐偏好、最近导航过哪、未婚妻是谁", "expect": {"observe": true}},
    {"id": "V3-100", "cat": "verify", "q": "把车调成适合狗晕车缓解的状态——等等狗没了，改成适合眯十分钟", "expect": {"min_tools": 1, "observe": true}}
