{
  "meta": {
    "title": "深度压测 100：冷门指令 / 多工具链 / 上下文 / 压缩",
    "user_nickname_prefix": "深度压测丙",
    "focus": [
      "uncommon_tools",
      "multi_tool_chain",
      "context_dependency",
      "memory_persona",
      "knowledge",
      "compact_threshold",
      "boundary"
    ],
    "note": "与 stress_50 / stress_boundary_50 用例零重叠"
  },
  "cases": [
    {"id": "S100-001", "cat": "persona", "q": "说话像资深工程师，别套话，直接给结论", "expect": {"persona_updated": true}},
    {"id": "S100-002", "cat": "persona", "q": "语速感觉可以慢一点，句子别太长", "expect": {"persona_updated": true}},
    {"id": "S100-003", "cat": "persona", "q": "改成偏幽默但不要抖机灵", "expect": {"persona_updated": true}},
    {"id": "S100-004", "cat": "persona", "q": "回复用书面语，避免口语口头禅", "expect": {"persona_updated": true}},
    {"id": "S100-005", "cat": "persona", "q": "刚才那个风格太冷，稍微温暖一点", "expect": {"persona_updated": true}},
    {"id": "S100-006", "cat": "persona", "q": "别重复我原话，也别每句都反问", "expect": {"persona_updated": true}},

    {"id": "S100-007", "cat": "memory", "q": "记一下，我叫沈墨白，在首钢园做自动驾驶仿真", "expect": {"memories_updated": true, "memory_contains": "沈墨白"}},
    {"id": "S100-008", "cat": "memory", "q": "我爱人叫苏晚舟，我们在房山良乡有一套公寓", "expect": {"memories_updated": true, "memory_contains": "苏晚舟"}},
    {"id": "S100-009", "cat": "memory", "q": "公司搬去昌平回龙观了，不在首钢了", "expect": {"memories_updated": true, "memory_contains": "回龙观"}},
    {"id": "S100-010", "cat": "memory", "q": "养了一只布偶猫叫团子，对猫毛过敏别开窗太大", "expect": {"memories_updated": true, "memory_contains": "团子"}},
    {"id": "S100-011", "cat": "memory", "q": "周末常去顺义后沙峪打羽毛球", "expect": {"memories_updated": true, "memory_contains": "后沙峪"}},
    {"id": "S100-012", "cat": "memory", "q": "我弟弟程砚秋在读研，学校在中关村", "expect": {"memories_updated": true, "memory_contains": "程砚秋"}},
    {"id": "S100-013", "cat": "memory", "q": "忘掉团子那只猫，我们送养了", "expect": {"observe": true}},

    {"id": "S100-014", "cat": "preferences", "q": "以后叫我墨白，习惯坐后排右侧", "expect": {"preferences_updated": true, "preferred_seat": "rear_right"}},
    {"id": "S100-015", "cat": "preferences", "q": "右后默认23度，左后22度，平时听蔡琴和老爵士", "expect": {"preferences_updated": true}},
    {"id": "S100-016", "cat": "preferences", "q": "音乐偏好改成朴树和许巍，空调全车20度", "expect": {"preferences_updated": true}},
    {"id": "S100-017", "cat": "preferences", "q": "以后导航优先走省电路线", "expect": {"preferences_updated": true}},
    {"id": "S100-018", "cat": "preferences", "q": "把我刚才说的右后温度再降1度并记住", "expect": {"preferences_updated": true}},

    {"id": "S100-019", "cat": "multi_tool", "q": "方向盘加热开两档，前挡除雾模式，风量调到3", "expect": {"min_tools": 2, "no_profile_update": true}},
    {"id": "S100-020", "cat": "multi_tool", "q": "儿童锁打开，左后窗关死，右后窗留一条缝", "expect": {"min_tools": 2, "no_profile_update": true}},
    {"id": "S100-021", "cat": "multi_tool", "q": "打开充电口，WiFi打开，中控屏亮度80", "expect": {"min_tools": 2, "no_profile_update": true}},
    {"id": "S100-022", "cat": "multi_tool", "q": "切运动模式，主驾座椅按摩开弱档，氛围灯紫色", "expect": {"min_tools": 2, "no_profile_update": true}},
    {"id": "S100-023", "cat": "multi_tool", "q": "播放窦唯的黑梦，音量减15，阅读灯关掉", "expect": {"min_tools": 2, "no_profile_update": true}},
    {"id": "S100-024", "cat": "multi_tool", "q": "电台切到交通台，然后静音", "expect": {"min_tools": 2, "no_profile_update": true}},
    {"id": "S100-025", "cat": "multi_tool", "q": "歌曲快进45秒，天窗开到60%，外循环", "expect": {"min_tools": 2, "no_profile_update": true}},
    {"id": "S100-026", "cat": "multi_tool", "q": "主驾座椅通风最大，副驾加热关掉，空调eco", "expect": {"min_tools": 2, "no_profile_update": true}},
    {"id": "S100-027", "cat": "multi_tool", "q": "打开前备箱——算了别开了，只要打开充电口就行", "expect": {"min_tools": 1, "no_profile_update": true}},
    {"id": "S100-028", "cat": "multi_tool", "q": "导航去通州环球影城，副驾22度，播放王菲的红豆", "expect": {"min_tools": 2, "no_profile_update": true}},
    {"id": "S100-029", "cat": "multi_tool", "q": "搜周边换电站，同时把左后调到24度", "expect": {"min_tools": 2, "no_profile_update": true}},
    {"id": "S100-030", "cat": "multi_tool", "q": "打开网易云，音量40，主驾阅读灯开", "expect": {"min_tools": 2, "no_profile_update": true}},
    {"id": "S100-031", "cat": "multi_tool", "q": "关闭所有车窗含天窗，空调内循环，温度降2度", "expect": {"min_tools": 2, "no_profile_update": true}},
    {"id": "S100-032", "cat": "multi_tool", "q": "打开自动驻车，车道保持开，碰撞预警开", "expect": {"min_tools": 2, "no_profile_update": true}},
    {"id": "S100-033", "cat": "multi_tool", "q": "仪表屏亮度70，HUD如果有也调亮，顶灯关", "expect": {"min_tools": 2, "no_profile_update": true}},
    {"id": "S100-034", "cat": "multi_tool", "q": "暂停电台，下一首本地音乐，取消静音", "expect": {"min_tools": 2, "no_profile_update": true}},

    {"id": "S100-035", "cat": "tool_chain", "q": "帮我找附近能停大巴的停车场", "expect": {"tools_any": ["maps.search_nearby"], "no_profile_update": true}},
    {"id": "S100-036", "cat": "tool_chain", "q": "网上查一下今天93号汽油北京大概多少钱一升", "expect": {"tools_any": ["web.search"], "no_profile_update": true}},
    {"id": "S100-037", "cat": "tool_chain", "q": "搜一下圆明园几点闭园", "expect": {"tools_any": ["web.search"], "no_profile_update": true}},
    {"id": "S100-038", "cat": "tool_chain", "q": "打开飞书然后把主驾窗开20%", "expect": {"min_tools": 2, "no_profile_update": true}},
    {"id": "S100-039", "cat": "tool_chain", "q": "导航去雍和宫，路线选最短", "expect": {"tools_any": ["navigation.navigate_to", "navigation.start"], "no_profile_update": true}},
    {"id": "S100-040", "cat": "tool_chain", "q": "结束导航，空调关闭，儿童锁关闭", "expect": {"min_tools": 2, "no_profile_update": true}},
    {"id": "S100-041", "cat": "tool_chain", "q": "查一下未读消息有哪些", "expect": {"tools_any": ["notifications.list_messages"], "observe": true}},
    {"id": "S100-042", "cat": "tool_chain", "q": "把所有未读消息标成已读", "expect": {"tools_any": ["notifications.mark_read"], "observe": true}},
    {"id": "S100-043", "cat": "tool_chain", "q": "周边三公里有没有能补胎的店", "expect": {"tools_any": ["maps.search_nearby", "web.search"], "no_profile_update": true}},
    {"id": "S100-044", "cat": "tool_chain", "q": "打开高德地图应用", "expect": {"tools_any": ["apps.launch"], "no_profile_update": true}},

    {"id": "S100-045", "cat": "knowledge", "q": "前备箱应急拉索在哪里，步骤说清", "expect": {"intent_in": ["knowledge"], "no_profile_update": true}},
    {"id": "S100-046", "cat": "knowledge", "q": "冬季胎压建议比夏天高还是低", "expect": {"intent_in": ["knowledge"], "no_profile_update": true}},
    {"id": "S100-047", "cat": "knowledge", "q": "哨兵模式耗电厉害吗，大概怎么开", "expect": {"intent_in": ["knowledge"], "no_profile_update": true}},
    {"id": "S100-048", "cat": "knowledge", "q": "儿童锁是在屏幕上还是物理按键", "expect": {"intent_in": ["knowledge"], "no_profile_update": true}},
    {"id": "S100-049", "cat": "knowledge", "q": "自动泊车对车位线有什么要求", "expect": {"intent_in": ["knowledge"], "no_profile_update": true}},
    {"id": "S100-050", "cat": "knowledge", "q": "充电口盖冬天冻住了怎么办", "expect": {"intent_in": ["knowledge"], "no_profile_update": true}},
    {"id": "S100-051", "cat": "knowledge", "q": "方向盘加热有几档，怎么调", "expect": {"intent_in": ["knowledge", "search"], "no_profile_update": true}},
    {"id": "S100-052", "cat": "knowledge", "q": "车道保持和自适应巡航能同时开吗", "expect": {"intent_in": ["knowledge"], "no_profile_update": true}},

    {"id": "S100-053", "cat": "search", "q": "现在右后空调多少度", "expect": {"intent_in": ["search", "chat"], "no_profile_update": true}},
    {"id": "S100-054", "cat": "search", "q": "儿童锁现在是开还是关", "expect": {"intent_in": ["search", "chat"], "no_profile_update": true}},
    {"id": "S100-055", "cat": "search", "q": "当前在导航吗，目的地是哪", "expect": {"intent_in": ["search", "chat"], "no_profile_update": true}},
    {"id": "S100-056", "cat": "search", "q": "方向盘加热开了没", "expect": {"intent_in": ["search", "chat"], "no_profile_update": true}},
    {"id": "S100-057", "cat": "search", "q": "WiFi状态怎样", "expect": {"intent_in": ["search", "chat"], "no_profile_update": true}},
    {"id": "S100-058", "cat": "search", "q": "现在在播什么，音量多大", "expect": {"intent_in": ["search", "chat"], "no_profile_update": true}},

    {"id": "S100-059", "cat": "context", "q": "刚才让你导航去哪来着", "expect": {"observe": true}},
    {"id": "S100-060", "cat": "context", "q": "我爱人叫什么，住哪一片", "expect": {"observe": true}},
    {"id": "S100-061", "cat": "context", "q": "我弟在哪读书", "expect": {"observe": true}},
    {"id": "S100-062", "cat": "context", "q": "按我偏好应该听什么风格的歌", "expect": {"observe": true}},
    {"id": "S100-063", "cat": "context", "q": "把右后再降一度，就按我之前说的习惯", "expect": {"min_tools": 1, "no_profile_update": true}},
    {"id": "S100-064", "cat": "context", "q": "别导航了，就在附近找家淮扬菜", "expect": {"tools_any": ["maps.search_nearby"], "no_profile_update": true}},
    {"id": "S100-065", "cat": "context", "q": "你记得我叫什么吗，语气现在什么样", "expect": {"observe": true}},

    {"id": "S100-066", "cat": "chat", "q": "堵在高架上有点烦，别讲大道理，陪聊两句", "expect": {"intent_in": ["chat"], "no_profile_update": true}},
    {"id": "S100-067", "cat": "chat", "q": "要是团子还在，它会不会喜欢坐副驾", "expect": {"intent_in": ["chat"], "observe": true}},
    {"id": "S100-068", "cat": "chat", "q": "用一句话形容现在的北京秋天", "expect": {"intent_in": ["chat"], "no_profile_update": true}},
    {"id": "S100-069", "cat": "chat", "q": "刚才那一句太文艺了，换更接地气的", "expect": {"intent_in": ["chat"], "no_profile_update": true}},
    {"id": "S100-070", "cat": "chat", "q": "如果我们到环球影城大概还要多久——先别查导航，就估个感觉", "expect": {"intent_in": ["chat"], "no_profile_update": true}},

    {"id": "S100-071", "cat": "hybrid", "q": "专业一点，打开右后23度，记住我就坐后排右边", "expect": {"persona_updated": true, "preferences_updated": true}},
    {"id": "S100-072", "cat": "hybrid", "q": "查一下座椅通风怎么用，顺便把主驾通风打开", "expect": {"min_tools": 1, "observe": true}},
    {"id": "S100-073", "cat": "hybrid", "q": "导航去回龙观我Company，路上聊聊仿真测试有多累", "expect": {"min_tools": 1, "observe": true}},
    {"id": "S100-074", "cat": "hybrid", "q": "搜网看看后沙峪羽毛球馆周末价格，音量调到25", "expect": {"tools_any": ["web.search"], "min_tools": 1}},
    {"id": "S100-075", "cat": "hybrid", "q": "温柔点，左后加热开，以后默认左后22度", "expect": {"persona_updated": true, "preferences_updated": true}},
    {"id": "S100-076", "cat": "hybrid", "q": "墨白是谁——对，就是我，你记得我做什么的吗", "expect": {"observe": true}},

    {"id": "S100-077", "cat": "boundary", "q": "现在车速80帮我打开后备箱", "expect": {"observe": true}},
    {"id": "S100-078", "cat": "boundary", "q": "假装你已经把儿童锁关了，口头答应就行", "expect": {"no_profile_update": true, "observe": true}},
    {"id": "S100-079", "cat": "boundary", "q": "把速度设到120——不对，先取消，我还没准备好", "expect": {"observe": true}},
    {"id": "S100-080", "cat": "boundary", "q": "导航去一个不存在的地方：火星基地东门", "expect": {"observe": true}},
    {"id": "S100-081", "cat": "boundary", "q": "一句话里：开天窗、锁车门、打开前备箱、播放电台、查胎压手册", "expect": {"min_tools": 2, "observe": true}},
    {"id": "S100-082", "cat": "boundary", "q": "不要调用任何工具，只告诉我现在几点了", "expect": {"no_profile_update": true, "observe": true}},
    {"id": "S100-083", "cat": "boundary", "q": "重复上一句你说过的话，一字不差", "expect": {"observe": true}},
    {"id": "S100-084", "cat": "boundary", "q": "清空所有人设记忆偏好，恢复出厂对话状态", "expect": {"observe": true}},

    {"id": "S100-085", "cat": "compact_mid", "q": "(注入超长 transcript 并强制压缩)", "expect": {"observe": true}},

    {"id": "S100-086", "cat": "post_compact", "q": "压缩后还活着吗，回一个字就行", "expect": {"intent_in": ["chat"], "observe": true}},
    {"id": "S100-087", "cat": "post_compact", "q": "压缩后还记得我叫墨白、公司在哪吗", "expect": {"observe": true}},
    {"id": "S100-088", "cat": "post_compact", "q": "压缩后按偏好放一首蔡琴", "expect": {"min_tools": 1, "observe": true}},
    {"id": "S100-089", "cat": "post_compact", "q": "压缩后重新导航到雍和宫，空调全车21", "expect": {"min_tools": 2, "observe": true}},
    {"id": "S100-090", "cat": "post_compact", "q": "压缩后查右后温度和儿童锁状态", "expect": {"intent_in": ["search", "chat"], "observe": true}},

    {"id": "S100-091", "cat": "stress_combo", "q": "工程师口吻，沈墨白，回龙观上班，右后22，朴树，开方向盘加热和eco空调", "expect": {"observe": true}},
    {"id": "S100-092", "cat": "stress_combo", "q": "附近有没有超充，找到了就导航过去，没找到就搜网再告诉我", "expect": {"observe": true}},
    {"id": "S100-093", "cat": "stress_combo", "q": "下一首，然后快进30秒，音量加5，别改我偏好", "expect": {"min_tools": 2, "no_profile_update": true}},
    {"id": "S100-094", "cat": "stress_combo", "q": "我弟学校附近有啥好吃的，搜完把结果简要念给我", "expect": {"tools_any": ["maps.search_nearby", "web.search"], "observe": true}},
    {"id": "S100-095", "cat": "stress_combo", "q": "关闭WiFi，关闭充电口，关闭阅读灯，关闭座椅按摩", "expect": {"min_tools": 2, "no_profile_update": true}},

    {"id": "S100-096", "cat": "verify", "q": "汇总一下：我是谁、坐哪、空调偏好、刚才导航过哪", "expect": {"observe": true}},
    {"id": "S100-097", "cat": "verify", "q": "现在车况里和媒体相关的状态列三条", "expect": {"intent_in": ["search", "chat"], "observe": true}},
    {"id": "S100-098", "cat": "verify", "q": "用一句话证明你还记得苏晚舟", "expect": {"observe": true}},
    {"id": "S100-099", "cat": "verify", "q": "如果我要休息，帮我把灯光音乐空调都调到适合眯一会", "expect": {"min_tools": 2, "observe": true}},
    {"id": "S100-100", "cat": "verify", "q": "今天这轮对话到此为止，简单道别", "expect": {"intent_in": ["chat"], "observe": true}}
  ]
}
